{
  "hosting": [
    {
      "target": "play",
      "public": "apps/play/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "editor",
      "public": "apps/editor/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
