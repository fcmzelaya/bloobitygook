# Copy to .env and fill in with the same Firebase web app config used by
# apps/editor/.env — these are public client identifiers, not secrets.
# Without this, the hub just shows "No games published yet."
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
