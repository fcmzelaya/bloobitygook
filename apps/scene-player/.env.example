# Copy to .env and fill in with the same Storage bucket used by
# apps/editor/.env and apps/hub/.env — a public client identifier, not a
# secret. This app fetches scenes/<id>.json and archetypes/<id>.json
# directly from this bucket's public download URL (see
# src/scene-storage.js), no Firebase SDK involved.
VITE_FIREBASE_STORAGE_BUCKET=
