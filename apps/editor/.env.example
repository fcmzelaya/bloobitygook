# Copy to .env and fill in with your Firebase project's web app config
# (Firebase console -> Project Settings -> Your apps -> SDK setup and
# configuration). These are public client identifiers, not secrets —
# real access control comes from storage.rules, not from hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
