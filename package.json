{
  "name": "bloobitygook",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev:play": "pnpm --filter @bloobitygook/play dev",
    "dev:editor": "pnpm --filter @bloobitygook/editor dev",
    "dev:tetris": "pnpm --filter @bloobitygook/tetris dev",
    "build": "pnpm --filter @bloobitygook/play build && pnpm --filter @bloobitygook/editor build && pnpm --filter @bloobitygook/tetris build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  }
}
